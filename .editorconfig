# 编辑器基线（B8）：只钉「不该有分歧」的几条，不做全仓重排/格式化。
# 缩进与换行口径的事实来源仍是各文件现状 + detekt 的 MaxLineLength/NewLineAtEndOfFile。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{ts,js,mjs,cjs,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 里的行尾双空格是**有意的硬换行**，不能裁。
trim_trailing_whitespace = false
